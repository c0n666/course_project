#, python-brace-format
msgid "{kcal} kcal · P {p} · F {f} · C {c}"
msgstr "{kcal} ккал · Б {p} · Ж {f} · В {c}"

#, python-brace-format
msgid "last {g} g"
msgstr "востаннє {g} г"

msgid "per 100 g"
msgstr "на 100 г"

#, python-brace-format
