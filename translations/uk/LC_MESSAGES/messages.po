msgstr "Прибрати {name} з улюблених"

msgid "Foods you log will show up here with your usual portion. Search or scan to get started."
msgstr ""
"Тут з'являтимуться продукти, які ви записуєте, разом зі звичною порцією. Почніть із пошуку чи "
"сканування."

msgid "Tap the star next to a food to keep it here."
msgstr "Натисніть зірочку біля продукту, щоб зберегти його тут."

msgid "Foods you create appear here. Use “Create food” for home recipes."
msgstr "Тут з'являються створені вами продукти. Для домашніх страв скористайтеся «Створити продукт»."

msgid "Could not update favorites."
msgstr "Не вдалося оновити улюблені."

msgid "No matches in your foods yet…"
msgstr "Серед ваших продуктів поки нічого…"

msgid "No matches. You are offline, so online search is unavailable."
msgstr "Нічого не знайдено. Ви офлайн, тож онлайн-пошук недоступний."

msgid "Searching Open Food Facts…"
msgstr "Шукаємо в Open Food Facts…"

msgid "Nothing found. Try another name, scan the barcode, or create the food."
msgstr "Нічого не знайдено. Спробуйте іншу назву, відскануйте штрихкод або створіть продукт."

msgid "Online search is unavailable right now."
msgstr "Онлайн-пошук зараз недоступний."

msgid "Choose a food first."
msgstr "Спершу виберіть продукт."

#, python-brace-format
msgid "Looking up {code}…"
msgstr "Шукаємо {code}…"

#, python-brace-format
msgid "Found: {name}"
msgstr "Знайдено: {name}"

#, python-brace-format
msgid "Barcode {code}"
msgstr "Штрихкод {code}"

msgid "Could not look up this barcode."
msgstr "Не вдалося знайти цей штрихкод."

msgid "Could not reach the food database."
msgstr "Не вдалося зв'язатися з базою продуктів."

msgid "You are offline — try again when connected."
msgstr "Ви офлайн — спробуйте, коли з'явиться зв'язок."

msgid "Camera needs a secure (HTTPS) connection. Type the number below instead."
msgstr "Камера працює лише через захищене (HTTPS) з'єднання. Введіть номер нижче."

msgid "Starting camera…"
msgstr "Вмикаємо камеру…"

msgid "Point the camera at a barcode."
msgstr "Наведіть камеру на штрихкод."

msgid "Camera access was denied. Type the barcode number below instead."
msgstr "Доступ до камери заборонено. Введіть номер штрихкоду нижче."

msgid "Camera is not available. Type the barcode number below instead."
msgstr "Камера недоступна. Введіть номер штрихкоду нижче."

msgid "A barcode has 8 to 14 digits."
msgstr "Штрихкод має від 8 до 14 цифр."

#, python-brace-format
msgid "Nutri-Score {g}"
msgstr "Nutri-Score {g}"

#, python-brace-format
msgid "Nutri-Score {g} (predicted by Kolos)"
msgstr "Nutri-Score {g} (прогноз Kolos)"

msgid "Not in the food list yet. Try search."
msgstr "Цього ще немає у списку продуктів. Спробуйте пошук."

#, python-brace-format
msgid "Confidence {n}%"
msgstr "Впевненість {n}%"

#, python-brace-format
msgid "Selected: {name}"
msgstr "Обрано: {name}"

msgid "Recognising…"
msgstr "Розпізнаємо…"

msgid "Could not recognise this photo."
msgstr "Не вдалося розпізнати це фото."

msgid "No food found on this photo. Try another angle."
msgstr "На фото не знайдено їжі. Спробуйте інший ракурс."

