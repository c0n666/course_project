# Copy to .env (git ignores it) and fill in. Read by `python app.py` and `flask ...` commands.

# Long random string; keeps sessions and email links valid across restarts.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Outgoing email (password reset, email confirmation). Leave MAIL_SERVER empty to print emails
# to the server console instead. Gmail: 2-step verification + app password
# (https://myaccount.google.com/apppasswords).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional sender name, e.g. Kolos <your.address@gmail.com>
MAIL_FROM=

# AI coach (optional)
# GEMINI_API_KEY=
# GROQ_API_KEY=
